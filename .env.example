APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

# Credentials provisioned by SuperAdminSeeder for the /admin area
NILO_SUPER_ADMIN_NAME="Nilo Admin"
NILO_SUPER_ADMIN_EMAIL=admin@nilo.test
NILO_SUPER_ADMIN_PASSWORD=password

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI="${APP_URL}/auth/google/callback"
# Native Google Sign-In on mobile mints ID tokens addressed to the platform's
# own client id, so those ids have to be on the allow-list too. No extra
# redirect URI is needed — the app never redirects through the browser.
GOOGLE_CLIENT_ID_ANDROID=
GOOGLE_CLIENT_ID_IOS=

# Free key from exchangerate-api.com. Leave blank to use the keyless open
# endpoint, which requires a visible attribution link on pages showing rates.
EXCHANGERATE_API_KEY=

LINKEDIN_ENABLED=false
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_REDIRECT_URI="${APP_URL}/auth/linkedin/callback"

# DPO Pay (subscription checkout). Both values come from the DPO merchant
# portal; DPO_COMPANY_TOKEN is a secret and must never be committed.
# DPO's WAF rejects a body containing a loopback URL, so DPO_CALLBACK_BASE
# cannot follow APP_URL while developing. A Herd host works: DPO never fetches
# the callback itself, it redirects the customer's browser, which resolves the
# host the same way yours does.
DPO_ENABLED=false
DPO_COMPANY_TOKEN=
DPO_SERVICE_TYPE=
DPO_DEFAULT_CURRENCY=ZMW
DPO_CALLBACK_BASE=https://your-site.test

# What the hosted payment page opens on, so the customer is not asked for
# things we already know. DPO_DEFAULT_PAYMENT is one of CC (card), MO (mobile
# money), PP, BT or XP. DPO_DEFAULT_PAYMENT_COUNTRY takes a full country name
# rather than a code and applies only when the default option is MO. Leave any
# of these blank to send nothing and let DPO choose.
DPO_CUSTOMER_COUNTRY=ZM
DPO_DEFAULT_PAYMENT=MO
DPO_DEFAULT_PAYMENT_COUNTRY=Zambia
