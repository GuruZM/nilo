APP_NAME=Nilo
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://app.example.com

APP_LOCALE=en
APP_FALLBACK_LOCALE=en

LOG_CHANNEL=daily
LOG_LEVEL=error

DB_CONNECTION=mysql
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=cpaneluser_nilo
DB_USERNAME=cpaneluser_nilo
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_SECURE_COOKIE=true

CACHE_STORE=database
QUEUE_CONNECTION=database
FILESYSTEM_DISK=local
BROADCAST_CONNECTION=log

# No Node process on shared hosting — render client-side.
INERTIA_SSR_ENABLED=false

MAIL_MAILER=smtp
MAIL_SCHEME=smtps
MAIL_HOST=mail.example.com
MAIL_PORT=465
MAIL_USERNAME=no-reply@example.com
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=no-reply@example.com
MAIL_FROM_NAME="${APP_NAME}"

NILO_SUPER_ADMIN_NAME="Nilo Admin"
NILO_SUPER_ADMIN_EMAIL=

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI="${APP_URL}/auth/google/callback"
GOOGLE_CLIENT_ID_ANDROID=
GOOGLE_CLIENT_ID_IOS=

FACEBOOK_ENABLED=false
LINKEDIN_ENABLED=false

# exchangerate-api.com key; blank uses the keyless endpoint (needs attribution).
EXCHANGERATE_API_KEY=

DPO_ENABLED=false
DPO_COMPANY_TOKEN=
DPO_SERVICE_TYPE=
DPO_DEFAULT_CURRENCY=ZMW
DPO_CALLBACK_BASE="${APP_URL}"
DPO_CUSTOMER_COUNTRY=ZM
DPO_DEFAULT_PAYMENT=MO
DPO_DEFAULT_PAYMENT_COUNTRY=Zambia
